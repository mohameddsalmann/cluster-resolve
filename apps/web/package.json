    "benchmark:operations": "vitest run tests/benchmarks/operations.benchmark.test.ts",
    "demo:seed": "tsx scripts/demo-seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
