# Cluster Resolve — server-only hosted Supabase runtime
# Copy to apps/web/.env.local and fill in. NEVER commit .env* files.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-sb-secret-key

# Legacy fallback only when the project does not yet expose an sb_secret key:
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
