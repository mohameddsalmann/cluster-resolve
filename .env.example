# ─────────────────────────────────────────────────────────────
# Cluster AI Supply Chain Control Tower — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env* files.
# ─────────────────────────────────────────────────────────────

# Supabase (client + server) — hosted Free dev project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Application/serverless runtime — Supabase Shared Pooler / Supavisor TRANSACTION mode.
# Copy the exact DATABASE_URL from Supabase Dashboard > Connect > Node.js/Postgres.
# Do not invent the region or hostname.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations and native PostgreSQL tools only — direct Postgres endpoint.
# Free-tier direct endpoints are IPv6 by default and may not work from Vercel/serverless runtimes.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Docker-free architecture
SUPABASE_DEVELOPMENT_MODE=HOSTED_DEV
LOCAL_SUPABASE_DISABLED=true
DOCKER_REQUIRED=false

# Cron + watchdog
CRON_SECRET=generate-a-random-secret
JOB_WATCHDOG_SECRET=generate-a-random-secret

# Watchdog thresholds
JOB_STALE_AFTER_MINUTES=20
JOB_MAX_RECOVERY_ATTEMPTS=3

# DB budget guards (percent of 500 MB)
DB_BUDGET_WARN_PCT=70
DB_BUDGET_BLOCK_PCT=85

# API key HMAC pepper
EVENTS_HMAC_PEPPER=generate-a-random-pepper

# App
APP_BASE_URL=http://localhost:3000
APP_ENV=development

# EDA connector
EDA_USER_AGENT=ClusterControlTower/0.1 (contact: your-email@example.com)
EDA_FETCH_TIMEOUT_MS=20000
EDA_MAX_DOCS_PER_RUN=40

# Optional
SENTRY_DSN=
LLM_API_KEY=
