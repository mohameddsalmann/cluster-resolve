{
  "name": "cluster-control-tower",
  "version": "0.0.0",
  "private": true,
  "description": "Cluster AI Supply Chain Control Tower — an unofficial, candidate-built reliability/observability layer for pharmaceutical AI procurement decisions.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter web test:db",
    "test:e2e": "pnpm --filter web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "ci:local": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:link": "supabase link --project-ref ${SUPABASE_PROJECT_REF:-YOUR_DEV_PROJECT_REF}",
    "supabase:db:push:check": "supabase db push --dry-run",
    "supabase:db:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --project-id ${SUPABASE_PROJECT_REF:-YOUR_DEV_PROJECT_REF} > apps/web/lib/db/generated-types.ts",
    "demo:seed": "pnpm --filter web demo:seed",
    "demo:reference:download": "pnpm --filter web demo:reference:download",
    "demo:data:generate": "pnpm --filter web demo:data:generate",
    "demo:data:validate": "pnpm --filter web demo:data:validate",
    "demo:data:import": "pnpm --filter web demo:data:import",
    "demo:preflight": "echo 'TODO: Phase 31 preflight script'",
    "regulatory:sync:eda": "pnpm --filter web regulatory:sync:eda"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  }
}
